{
  "name": "cimaise",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/tv",
    "packages/*",
    "mocks",
    "scripts"
  ],
  "scripts": {
    "build": "node scripts/build/build.mjs && node scripts/build/size-report.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:es5": "node scripts/build/check-es5.mjs",
    "check": "npm run typecheck && npm run build && npm run check:es5 && npm test",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "es-check": "^9.8.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
