{
  "name": "cimaise",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/tv",
    "apps/blank",
    "packages/*",
    "mocks",
    "scripts"
  ],
  "scripts": {
    "build": "node scripts/build/all.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:es5": "node scripts/build/check-es5.mjs",
    "check:css": "node scripts/build/check-css.mjs",
    "check": "npm run typecheck && npm run build && npm run check:es5 && npm run check:css && npm test",
    "dev": "node scripts/dev/server.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "devDependencies": {
    "es-check": "^9.8.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
