<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lanceur de la sonde native « Voie B » (docs/home-button.md). App JETABLE, distincte de cimaise
  (cimaise001.Cimaise) et de cimaise-blank. Elle lance org.cimaise.sondenative via l'API Web
  officielle, puis lit l'état des apps en cours (getAppsContext) pour savoir si le code natif tourne.
  - package "cmzlanceur" (10 caractères), id "cmzlanceur.Lanceur".
  - privilèges publics strictement nécessaires : application.launch (launch) et
    application.info (getAppInfo / getAppsContext).
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://local.cimaise/lanceur" version="0.0.2" viewmodes="maximized">
  <tizen:application id="cmzlanceur.Lanceur" package="cmzlanceur" required_version="5.0"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <icon src="icon.png"/>
  <name>Lanceur sonde</name>
  <tizen:profile name="tv-samsung"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto"/>
</widget>
