     Aucun privilège déclaré, volontairement. -->
<manifest xmlns="http://tizen.org/ns/packages" api-version="5.0" package="org.cimaise.sondenative" version="1.0.0">
	<ui-application appid="org.cimaise.sondenative" exec="sondenative" type="capp" multiple="false" taskmanage="true" nodisplay="false" launch_mode="single">
		<icon>sonde.png</icon>
		<label>Sonde native</label>
	</ui-application>
</manifest>
