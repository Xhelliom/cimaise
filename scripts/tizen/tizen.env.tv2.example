# Copier vers .local/tizen.env.tv2 (ignoré par git) ; utilisé avec CIMAISE_TV=tv2. Ne jamais committer le vrai fichier.
TV_IP=192.168.1.50
TV_PORT=26101
APP_ID=cimaise001.Cimaise
APP_DIR=apps/tv/dist
# Profil TV2, créé par `CIMAISE_TV=tv2 scripts/tizen/setup-profile.sh` ; jamais « cimaise » (profil Samsung de la Frame).
SIGN_PROFILE=cimaise-tv2
# required_version de la copie empaquetée (apps/tv/config.xml n'est pas modifié).
REQUIRED_VERSION=4.0
# Auteur Tizen créé par la CLI du SDK (identité TV2 : ne pas le recréer).
AUTHOR_CERT=/work/.local/certs/tv2-tizen-author.p12
AUTHOR_PASSWORD=
# Distributeur public historique du SDK (chemin dans l'image Docker ; mot de passe public fourni par le SDK).
DISTRIBUTOR_CERT=/home/tizen/tizen-studio/tools/certificate-generator/certificates/distributor/sdk-public/tizen-distributor-signer.p12
DISTRIBUTOR_PASSWORD=tizenpkcs12passfordsigner
