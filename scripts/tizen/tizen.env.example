# Copier vers .local/tizen.env (ignoré par git). Ne jamais committer le vrai fichier.
TV_IP=192.168.1.50
TV_PORT=26101
# Identifiant de l'app (config.xml) : <tizen:application id="PKG.APP" package="PKG">
APP_ID=cimaise00.Cimaise
# Dossier de l'app web à empaqueter, relatif à la racine du dépôt
APP_DIR=apps/tv
# Profil de signature créé par scripts/tizen/setup-profile.sh
SIGN_PROFILE=cimaise
# Certificats Samsung (chemins DANS le conteneur : /work/.local/...)
AUTHOR_CERT=/work/.local/certs/author.p12
AUTHOR_PASSWORD=
DISTRIBUTOR_CERT=/work/.local/certs/distributor.p12
DISTRIBUTOR_PASSWORD=
